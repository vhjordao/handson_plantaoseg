# PlantãoSeguro: variáveis de ambiente.
# Copie para `.env` (ignorado pelo Git) com `make env`.
# NUNCA commite valores reais. Valores "dev-only" servem só para o ambiente local.

# --- Supabase (Victor providencia; local: valores impressos por `supabase start`) ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor (API de matching). Nunca no navegador.
# Use a service_role, e não a sb_secret, que ficou em cerca de 50 chamadas por segundo (ADR 0010).
SUPABASE_SERVICE_ROLE_KEY=dev-only-troque-esta-chave

# --- LLM do produto: Gemini (ADR 0003; Victor cria a chave no Google AI Studio) ---
# Camada gratuita: só com dados sintéticos (o Google usa o conteúdo para melhorar produtos).
# Na demo, use a chave de um projeto com faturamento ativo (camada paga).
GEMINI_API_KEY=
# IDs lidos na documentação oficial em 28/10/2026; reconferir antes de fixar na implementação.
LLM_MODEL_EXTRACAO=gemini-3.5-flash-lite
LLM_MODEL_AMBIGUO=gemini-3.8-flash

# --- Telegram (P1; Victor cria o bot) ---
TELEGRAM_BOT_TOKEN=

# --- n8n (modo fila: n8n + worker + Redis + Postgres próprio) ---
# Estes valores vão no .env do servidor, nunca no Git (infra/README.md).
# Gere valores próprios: `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=dev-only-troque-esta-chave-32-caracteres
# Segredo compartilhado dos webhooks entre n8n e a API de matching.
N8N_WEBHOOK_SECRET=dev-only-troque-este-segredo
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=dev-only-troque-esta-senha
# E-mail do certificado HTTPS do Traefik (Let's Encrypt).
SSL_EMAIL=voce@exemplo.invalid
# Nome público do editor do n8n no Traefik (no servidor, n8n.<nome do servidor>). Fica só no .env do servidor.
N8N_EDITOR_HOST=n8n.exemplo.invalid

# --- API de matching ---
MATCHING_API_URL=http://localhost:8000
# Onde a API avisa que a cascata começou (ADR 0013). Vazio: não avisa. No servidor, vem do Compose.
N8N_CASCADE_URL=
# Nome público da API no Traefik (no servidor, api.<nome do servidor>). Fica só no .env do servidor.
API_HOST=api.exemplo.invalid
# Endereços da web que podem chamar a API, separados por vírgula. Nunca *.
API_CORS_ORIGINS=http://localhost:3000
# Limite por IP de origem, em requisições por segundo (ver infra/README.md).
API_RATE_AVERAGE=30
API_RATE_BURST=60
# 1 abre /docs e /openapi.json. Só em desenvolvimento.
API_DOCS=

# --- Langfuse (opcional, Etapa 3; somente dados sintéticos) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Acesso às contas: só para comandos locais, nunca vão para o app (ADR 0007) ---
# Token do Supabase com escopo só no projeto e com validade (Account > Access Tokens).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Token da Vercel com escopo só neste projeto e com validade (Account Settings > Tokens).
VERCEL_TOKEN=
